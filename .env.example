NEXT_PUBLIC_SUPABASE_URL=https://db.absgroup.biz.id
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
APP_PIN=1324
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
TASK_API_TOKEN=your_token
NEXT_PUBLIC_HERMES_URL=https://hermes.absgroup.biz.id
HERMES_API_KEY=your_hermes_api_key

# WhatsApp Gateway (Pilihan: 'fonnte' atau 'waha')
WA_PROVIDER=fonnte
FONNTE_TOKEN=your_fonnte_token
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default

# Vercel Cron Secret
CRON_SECRET=taskhariini

# BigQuery Service Account
# Anda bisa mengisi salah satu dari opsi berikut:
# 1. BIGQUERY_SERVICE_ACCOUNT_KEY: Isi dengan string Base64 dari file JSON (sangat disarankan untuk Vercel agar bebas masalah newline/escaping) atau teks JSON langsung.
# 2. BIGQUERY_SERVICE_ACCOUNT_PATH: Path ke file service-account.json di server lokal.
BIGQUERY_SERVICE_ACCOUNT_KEY=
# BIGQUERY_SERVICE_ACCOUNT_PATH=/path/to/service-account.json
